generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Message {
  id        String   @id
  author    String
  content   String
  timestamp BigInt
  likes     Int      @default(0)
  votes     MessageLike[]
}

model MessageLike {
  messageId String
  ip        String
  message   Message @relation(fields: [messageId], references: [id], onDelete: Cascade)

  @@id([messageId, ip])
}

model PostCooldown {
  ip            String   @id
  lastPostTime  BigInt
}
